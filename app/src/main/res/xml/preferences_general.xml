<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    app:iconSpaceReserved="false"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="استقرار الأذان والتذكيرات"
        android:layout="@layout/preference_catagory">
        <Preference
            android:key="device_optimization_button"
            android:title="@string/device_optimization_button_title"
            android:summary="@string/device_optimization_button_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="رمضان"
        android:layout="@layout/preference_catagory">
        <Preference
            android:key="open_ramadan_screen"
            android:title="شاشة رمضان"
            android:summary="الإمساكية، مدفع الإفطار، والمسحراتي" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="إهداء"
        android:layout="@layout/preference_catagory">
        <Preference
            android:layout="@layout/dedication_layout"
            android:selectable="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="مظهر التطبيق"
        android:layout="@layout/preference_catagory">
        <ListPreference
            android:defaultValue="dark"
            android:entries="@array/app_theme_entries"
            android:entryValues="@array/app_theme_values"
            android:key="app_theme_mode"
            android:title="المظهر"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/language"
        android:layout="@layout/preference_catagory">
        <com.alaaeltaweel.thikrallah.Utilities.MyListPreference
            android:entries="@array/languagelist"
            android:entryValues="@array/languagelistValues"
            android:key="language"
            android:title="@string/language" />
    </PreferenceCategory>

</PreferenceScreen>
