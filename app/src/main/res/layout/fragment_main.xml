<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg">


    <ScrollView
        android:id="@+id/container_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

           <!-- الإهداء والصورة جنب بعض -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/banner_bg"
    android:gravity="center"
    android:padding="16dp"
    android:layout_marginBottom="8dp">

    <!-- الإهداء (النص) -->
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="(صدقة جارية)   إهداءً إلى روح والدتي ووالدي الحبيب\nمحمد عبد العظيم طرفايه الطويل\nرحمه الله وأسكنه فسيح جناته"
        android:textColor="#FFD700"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"/>

    <!-- فاصل عمودي -->
    <View
        android:layout_width="1dp"
        android:layout_height="48dp"
        android:background="#FFD700"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>

    <!-- صورة الوالد والنص -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/father_photo"
            android:scaleType="centerCrop"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="محمد عبد العظيم طرفايه الطويل"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="رحمه الله وأسكنه فسيح جناته"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center"/>
</LinearLayout>
    
</LinearLayout>
            <!-- ✅ كارد التاريخ والرمضان -->
            <LinearLayout
                android:id="@+id/date_ramadan_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="18dp"
                android:background="@drawable/date_card_bg"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp">

                <!-- التاريخ الهجري (الأبرز) -->
                <TextView
                    android:id="@+id/text_hijri_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/brand_teal"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <!-- التاريخ الميلادي -->
                <TextView
                    android:id="@+id/text_gregorian_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="--"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="center" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/brand_gold"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp" />

                <!-- الفجر والمغرب (وفي رمضان: الإمساك والإفطار) -->
                <LinearLayout
                    android:id="@+id/layout_suhoor_iftar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/text_suhoor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="الفجر: --"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:gravity="start" />
                    <TextView
                        android:id="@+id/text_iftar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="المغرب: --"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:gravity="end" />
                </LinearLayout>

                <!-- الطقس (سطر صغير) -->
                <LinearLayout
                    android:id="@+id/layout_weather"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:id="@+id/text_weather_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌤"
                        android:textSize="16sp"
                        android:layout_marginEnd="6dp" />
                    <TextView
                        android:id="@+id/text_weather"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- في رمضان فقط: اليوم + العداد التنازلي -->
                <TextView
                    android:id="@+id/text_ramadan_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="--"
                    android:textColor="@color/brand_teal"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:gravity="center" />
                <TextView
                    android:id="@+id/text_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/brand_teal"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    android:gravity="center" />
                <TextView
                    android:id="@+id/text_countdown_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:visibility="gone"
                    android:gravity="center" />

                <!-- شريط رمضان: المدخل الوحيد لشاشة رمضان -->
                <LinearLayout
                    android:id="@+id/ramadan_strip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layoutDirection="rtl"
                    android:padding="12dp"
                    android:background="@drawable/ramadan_strip_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/ramadan_icon_circle"
                        android:padding="10dp"
                        android:src="@drawable/ic_ramadan_moon"
                        android:tint="@color/ramadan_icon_tint"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="رمضان"
                            android:textColor="@color/ramadan_strip_title"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="الإمساكية • المدفع • المسحراتي • الأصوات"
                            android:textColor="@color/ramadan_strip_sub"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="‹"
                        android:textColor="@color/ramadan_strip_title"
                        android:textSize="30sp" />
                </LinearLayout>

                <!-- خارج رمضان: كم يوم فاضل -->
                <TextView
                    android:id="@+id/text_ramadan_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_athan"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/card_bg"
                    android:drawableTop="@drawable/athan"
                    android:text="@string/athan"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="10dp" />

               <Button
                    android:id="@+id/button_quran"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/card_bg"
                    android:drawableTop="@drawable/quran"
                    android:text="@string/quranic_verses"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="10dp" />
               

            </LinearLayout>


            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_morning_thikr"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/card_bg"
                    android:drawableTop="@drawable/sun"
                    android:text="@string/morningThikr"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="10dp" />
               
                <Button
                    android:id="@+id/button_night_thikr"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/card_bg"
                    android:drawableTop="@drawable/moon"
                    android:text="@string/nightThikr"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="10dp" />

                 

            </LinearLayout>

            <!-- Row 3 -->
             <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_my_athkar"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/card_bg"
                    android:drawableTop="@drawable/my_athkar"
                    android:text="@string/my_athkar"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="10dp" />

               <Button
                    android:id="@+id/button_qibla"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/card_bg"
                    android:drawableTop="@drawable/qibla"
                    android:text="@string/qibla"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="10dp" />

            </LinearLayout>

            <!-- Row 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/hisn_almuslim"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/card_bg"
                    android:drawableTop="@drawable/hisn_almuslim"
                    android:text="@string/hisn_almuslim"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="10dp" />

                <Button
                    android:id="@+id/button_settings"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/card_bg"
                    android:drawableTop="@drawable/settings"
                    android:text="@string/Settings"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="10dp" />

            </LinearLayout>

            <!-- الإذاعة والمكتبة -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_radio"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/card_bg"
                    android:drawableTop="@drawable/photo_radio"
                    android:text="إذاعات القرآن الكريم"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="10dp" />

                <Button
                    android:id="@+id/button_library"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/card_bg"
                    android:drawableTop="@drawable/photo_library"
                    android:text="المكتبة: التفسير والأحاديث"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="10dp" />

            </LinearLayout>

            <!-- متتبع الصلاة -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_prayer_tracker"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/card_bg"
                    android:drawableTop="@drawable/photo_prayer"
                    android:text="متتبع الصلاة اليومي"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="10dp" />

                <Button
                    android:id="@+id/button_cards"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/card_bg"
                    android:drawableTop="@drawable/photo_cards"
                    android:text="بطاقات التهنئة"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="10dp" />

            </LinearLayout>

            <Button
                android:id="@+id/button_sadaqa"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_margin="8dp"
                android:background="@drawable/card_bg"
                android:drawableTop="@drawable/share_button"
                android:text="@string/sadaqa"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="10dp" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
